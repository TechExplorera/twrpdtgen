{% include 'LICENSE.jinja2' %}

DEVICE_PATH := device/{{ device_info.manufacturer }}/{{ device_info.codename }}

# For building with minimal manifest
ALLOW_MISSING_DEPENDENCIES := true
BUILD_BROKEN_DUP_RULES := true
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
BUILD_BROKEN_MISSING_REQUIRED_MODULES := true

{% if tree.is_ab %}
# A/B
AB_OTA_UPDATER := true
AB_OTA_PARTITIONS +=
{%- for partition in tree.ab_partitions %} \
    {{ partition }}
{%- endfor %}


{% endif %}
# Architecture
TARGET_ARCH := {{ device_info.arch.arch }}
TARGET_ARCH_VARIANT := {{ device_info.arch.arch_variant }}
TARGET_CPU_ABI := {{ device_info.arch.cpu_abi }}
{% if device_info.arch.bitness != 64 %}
TARGET_CPU_ABI2 := armeabi
{% endif %}
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := {{ device_info.cpu_variant }}

{% if device_info.second_arch %}
TARGET_2ND_ARCH := {{ device_info.second_arch.arch }}
TARGET_2ND_ARCH_VARIANT := {{ device_info.second_arch.arch_variant }}
TARGET_2ND_CPU_ABI := {{ device_info.second_arch.cpu_abi }}
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := {{ device_info.second_cpu_variant }}

{% endif %}
{% if device_info.arch.bitness != 64 %}
TARGET_USES_64_BIT_BINDER := true

{% endif %}
# Bootloader
{% if device_info.bootloader_board_name %}
TARGET_BOOTLOADER_BOARD_NAME := {{ device_info.bootloader_board_name }}
{% endif %}
TARGET_NO_BOOTLOADER := true

{% if device_info.screen_density %}
# Display
TARGET_SCREEN_DENSITY := {{ device_info.screen_density }}

{% endif %}
# Kernel
{% if tree.header_version %}
BOARD_BOOT_HEADER_VERSION := {{ tree.header_version }}
{% endif %}
{% if image_info.base_address %}
BOARD_KERNEL_BASE := {{ image_info.base_address }}
{% endif %}
{% if image_info.cmdline %}
BOARD_KERNEL_CMDLINE := {{ image_info.cmdline }}
{% endif %}
{% if image_info.pagesize %}
BOARD_KERNEL_PAGESIZE := {{ image_info.pagesize }}
{% endif %}
{% if tree.header_version < 3 %}
{% if image_info.kernel_offset %}
BOARD_KERNEL_OFFSET := {{ image_info.kernel_offset }}
{% endif %}
{% if image_info.ramdisk_offset %}
BOARD_RAMDISK_OFFSET := {{ image_info.ramdisk_offset }}
{% endif %}
{% if image_info.tags_offset %}
BOARD_KERNEL_TAGS_OFFSET := {{ image_info.tags_offset }}
{% endif %}
{% if tree.header_version == 2 and image_info.dtb_offset %}
BOARD_DTB_OFFSET := {{ image_info.dtb_offset }}
{% endif %}
{% endif %}
{% if tree.header_version %}
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
{% endif %}
{% if tree.board_name %}
BOARD_MKBOOTIMG_ARGS += --board {{ tree.board_name }}
{% endif %}
{% if tree.header_version < 3 %}
{% if image_info.kernel_offset %}
BOARD_MKBOOTIMG_ARGS += --kernel_offset $(BOARD_KERNEL_OFFSET)
{% endif %}
{% if image_info.ramdisk_offset %}
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET)
{% endif %}
{% if image_info.tags_offset %}
BOARD_MKBOOTIMG_ARGS += --tags_offset $(BOARD_KERNEL_TAGS_OFFSET)
{% endif %}
{% if tree.header_version == 2 and image_info.dtb_offset %}
BOARD_MKBOOTIMG_ARGS += --dtb_offset $(BOARD_DTB_OFFSET)
{% endif %}
{% endif %}
BOARD_KERNEL_IMAGE_NAME := {{ tree.kernel_image_name }}
{% if image_info.dtbo %}
BOARD_KERNEL_SEPARATED_DTBO := true
{% endif %}
TARGET_KERNEL_ARCH := {{ device_info.arch.arch }}
TARGET_KERNEL_HEADER_ARCH := {{ device_info.arch.arch }}

# Kernel - prebuilt
TARGET_FORCE_PREBUILT_KERNEL := true
ifeq ($(TARGET_FORCE_PREBUILT_KERNEL),true)
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
{% if image_info.dt %}
TARGET_PREBUILT_DT := $(DEVICE_PATH)/prebuilt/dt.img
BOARD_MKBOOTIMG_ARGS += --dt $(TARGET_PREBUILT_DT)
{% endif %}
{% if image_info.dtb and tree.header_version < 3 %}
TARGET_PREBUILT_DTB := $(DEVICE_PATH)/prebuilt/dtb.img
BOARD_MKBOOTIMG_ARGS += --dtb $(TARGET_PREBUILT_DTB)
BOARD_INCLUDE_DTB_IN_BOOTIMG :=
{% endif %}
{% if image_info.dtbo %}
BOARD_PREBUILT_DTBOIMAGE := $(DEVICE_PATH)/prebuilt/dtbo.img
BOARD_KERNEL_SEPARATED_DTBO :=
{% endif %}
endif

# Partitions
{% if image_info.pagesize %}
BOARD_FLASH_BLOCK_SIZE := {{ image_info.pagesize|int * 64 }} # (BOARD_KERNEL_PAGESIZE * 64)
{% endif %}
{% if tree.recovery_as_boot %}
BOARD_BOOTIMAGE_PARTITION_SIZE := {{ image_info.origsize }}
{% else %}
BOARD_RECOVERYIMAGE_PARTITION_SIZE := {{ image_info.origsize }}
{% endif %}
BOARD_HAS_LARGE_FILESYSTEM := true
BOARD_SYSTEMIMAGE_PARTITION_TYPE := {{ tree.logical_partitions.get('system', 'ext4') }}
{% set data_partition = fstab.get_partition_by_mount_point('/data') %}
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := {{ data_partition.fs_type if data_partition else 'ext4' }}
{% for partition in tree.copy_out_partitions %}
BOARD_{{ partition|upper }}IMAGE_FILE_SYSTEM_TYPE := {{ tree.logical_partitions[partition] }}
TARGET_COPY_OUT_{{ partition|upper }} := {{ partition }}
{% endfor %}
{% if 'vendor' not in tree.copy_out_partitions %}
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_COPY_OUT_VENDOR := vendor
{% endif %}
{% if tree.has_metadata_partition %}
BOARD_USES_METADATA_PARTITION := true
{% endif %}

{% if tree.uses_dynamic_partitions %}
# Dynamic partitions
{% if not tree.super_partition_size_is_known %}
# TODO: Replace with the real size of your super partition (in bytes), e.g.:
#   adb shell blockdev --getsize64 /dev/block/by-name/super
# or regenerate the tree with: python3 -m twrpdtgen --super-size <bytes> <image>
{% endif %}
BOARD_SUPER_PARTITION_SIZE := {{ tree.super_partition_size }}
BOARD_SUPER_PARTITION_GROUPS := {{ tree.super_group_name }}
# BOARD_SUPER_PARTITION_SIZE{% if tree.is_ab and not tree.virtual_ab %} / 2{% endif %} - 4MB
BOARD_{{ tree.super_group_name|upper }}_SIZE := {{ tree.super_group_size }}
BOARD_{{ tree.super_group_name|upper }}_PARTITION_LIST := {{ tree.logical_partitions.keys()|join(' ') }}

{% endif %}
# Platform
TARGET_BOARD_PLATFORM := {{ device_info.platform }}

# Recovery
BOARD_USES_RECOVERY_AS_BOOT := {{ "true" if tree.recovery_as_boot else "false" }}
{% if image_info.dtbo and not tree.recovery_as_boot and tree.header_version < 3 %}
BOARD_INCLUDE_RECOVERY_DTBO := true
{% endif %}
{% if tree.ramdisk_compression == "lz4" %}
BOARD_RAMDISK_USE_LZ4 := true
{% elif tree.ramdisk_compression == "lzma" %}
LZMA_RAMDISK_TARGETS := recovery
{% endif %}
{% if device_info.device_pixel_format %}
TARGET_RECOVERY_PIXEL_FORMAT := {{ device_info.device_pixel_format }}
{% endif %}
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

{% if image_info.sigtype == "AVBv2" %}
# Verified Boot
BOARD_AVB_ENABLE := true
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
{% if not tree.recovery_as_boot %}
BOARD_AVB_RECOVERY_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem
BOARD_AVB_RECOVERY_ALGORITHM := SHA256_RSA4096
BOARD_AVB_RECOVERY_ROLLBACK_INDEX := 1
BOARD_AVB_RECOVERY_ROLLBACK_INDEX_LOCATION := 1
{% endif %}

{% endif %}
# Hack: prevent anti rollback
PLATFORM_SECURITY_PATCH := 2099-12-31
VENDOR_SECURITY_PATCH := $(PLATFORM_SECURITY_PATCH)
PLATFORM_VERSION := 99.87.36
PLATFORM_VERSION_LAST_STABLE := $(PLATFORM_VERSION)

{% if tree.uses_crypto %}
# Crypto
# NOTE: decryption also needs the device's keymaster/keymint and gatekeeper
# blobs (and their dependencies) copied into recovery/root/vendor.
TW_INCLUDE_CRYPTO := true
{% if tree.uses_fbe %}
TW_INCLUDE_CRYPTO_FBE := true
TW_USE_FSCRYPT_POLICY := {{ tree.fscrypt_policy }}
{% endif %}
{% if tree.uses_metadata_encryption %}
TW_INCLUDE_FBE_METADATA_DECRYPT := true
{% endif %}

{% endif %}
# TWRP Configuration
TW_THEME := portrait_hdpi
TW_EXTRA_LANGUAGES := true
TW_DEFAULT_LANGUAGE := en
TW_SCREEN_BLANK_ON_BOOT := true
TW_INPUT_BLACKLIST := "hbtp_vm"
TW_USE_TOOLBOX := true
TW_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_RESETPROP := true
TW_INCLUDE_LIBRESETPROP := true
TW_FRAMERATE := 60
TARGET_USES_MKE2FS := true
RECOVERY_SDCARD_ON_DATA := true
TW_INCLUDE_NTFS_3G := true
{% if tree.uses_dynamic_partitions %}
TW_INCLUDE_FASTBOOTD := true
TW_INCLUDE_LPDUMP := true
TW_INCLUDE_LPTOOLS := true
{% endif %}
{% if tree.kernel_modules %}
TW_LOAD_VENDOR_MODULES := "{{ tree.kernel_modules|join(' ') }}"
{% endif %}
{% if tree.recovery_as_boot %}
TW_HAS_NO_RECOVERY_PARTITION := true
{% endif %}
{% if tree.soc_vendor == "qcom" %}
TARGET_RECOVERY_QCOM_RTC_FIX := true
{% endif %}
{% if tree.is_samsung %}

# Samsung
TW_NO_REBOOT_BOOTLOADER := true
TW_HAS_DOWNLOAD_MODE := true
TW_USE_SERIALNO_PROPERTY_FOR_DEVICE_ID := true
# TWRP can't decrypt Samsung's /data (proprietary keystore), format data to use it
TW_INCLUDE_CRYPTO := false
{% endif %}
